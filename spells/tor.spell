# Tor built with dietlibc for CLEANUX (anonymous networking)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="tor"
PACKAGE_VERSION="0.4.8.12"
PACKAGE_RELEASE="1"

DEPENDENCIES=("zlib" "openssl" "libevent" "xz")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://dist.torproject.org/tor-0.4.8.12.tar.gz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    local tor_cflags="${CFLAGS:-}"
    [ "${LIBC:-dietlibc}" = dietlibc ] && \
        tor_cflags="$tor_cflags -DPTHREAD_MUTEX_RECURSIVE=PTHREAD_MUTEX_RECURSIVE_NP"
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        --disable-asciidoc \
        --disable-systemd \
        --disable-seccomp \
        --disable-unittests \
        --disable-gcc-hardening \
        --disable-linker-hardening \
        CC="$CC" \
        CFLAGS="$tor_cflags" \
        LDFLAGS="${LDFLAGS:-}"
    # dietlibc advertises GLOB_ALTDIRFUNC but its glob_t has no gl_* function
    # pointers.  Disable that optional path (tor only uses it for sandboxing).
    sed -i 's/#ifdef GLOB_ALTDIRFUNC/#if 0/' src/lib/fs/path.c
    # libtool/automake put LIBS after the archives, so repeat the compat
    # library there to satisfy symbols in libtor-* (dietlibc builds only).
    local libs="-lpthread -lm"
    [ "${LIBC:-dietlibc}" = dietlibc ] && libs="-lpthread -ldietcompat -lm"
    make -j"${JOBS:-$(nproc)}" LIBS="$libs"
    make DESTDIR="$DESTDIR" install
}
