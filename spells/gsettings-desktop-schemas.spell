# gsettings-desktop-schemas (dependency for MATE)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="gsettings-desktop-schemas"
PACKAGE_VERSION="47.1"
PACKAGE_RELEASE="1"

DEPENDENCIES=("glib")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://download.gnome.org/sources/gsettings-desktop-schemas/47/gsettings-desktop-schemas-47.1.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="meson"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=0

build() {
    log "Configuring ${PACKAGE_NAME} with $CC (meson)"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --default-library=static \
        || { cat build/meson-logs/meson-log.txt 2>/dev/null; return 1; }
    ninja -C build
    DESTDIR="$DESTDIR" meson install -C build
}
