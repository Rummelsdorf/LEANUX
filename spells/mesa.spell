# Mesa (software rasterizer for xorg-server)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="mesa"
PACKAGE_VERSION="24.2.8"
PACKAGE_RELEASE="1"

DEPENDENCIES=("zlib" "expat" "libdrm" "xorgproto" "libxcb" "libX11" "libXext" "libXfixes" "libXrandr" "libXrender" "libXi" "libXtst")
EXTERNAL_DEPENDENCIES=("python3" "mako" "pyyaml")
SOURCE_URL="https://mesa.freedesktop.org/archive/mesa-24.2.8.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="meson"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC (meson)"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --default-library=static \
        -Dplatforms=x11 \
        -Dgallium-drivers=swrast \
        -Dvulkan-drivers= \
        -Dglx=dri \
        -Dllvm=disabled \
        -Dgles1=disabled \
        -Dgles2=disabled \
        -Dopengl=true \
        || { cat build/meson-logs/meson-log.txt 2>/dev/null; return 1; }
    ninja -C build
    DESTDIR="$DESTDIR" meson install -C build
}
