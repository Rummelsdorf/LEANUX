# libxkbfile – XKB file handling library (added port dependency of xkbcomp)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="libxkbfile"
PACKAGE_VERSION="1.1.3"
PACKAGE_RELEASE="1"

DEPENDENCIES=("xorgproto" "libX11")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://www.x.org/releases/individual/lib/libxkbfile-1.1.3.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        --disable-shared \
        --enable-static \
        CC="$CC" \
        CFLAGS="${CFLAGS:-} -Dindex=index -Drindex=rindex" \
        LDFLAGS="${LDFLAGS:-}"
    make -j"${JOBS:-$(nproc)}"
    make DESTDIR="$DESTDIR" install
}
