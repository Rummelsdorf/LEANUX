# ffmpeg (dependency for vlc)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="ffmpeg"
PACKAGE_VERSION="7.1"
PACKAGE_RELEASE="1"

DEPENDENCIES=("zlib" "xz")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://ffmpeg.org/releases/ffmpeg-7.1.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        --disable-shared \
        --enable-static \
        --disable-autodetect \
        --disable-doc \
        --disable-debug \
        --enable-zlib \
        --enable-lzma \
        CC="$CC" \
        CFLAGS="${CFLAGS:-}" \
        LDFLAGS="${LDFLAGS:-}"
    make -j"${JOBS:-$(nproc)}"
    make DESTDIR="$DESTDIR" install
}
