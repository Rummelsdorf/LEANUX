# alsa-lib (dependency for vlc)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="alsa-lib"
PACKAGE_VERSION="1.2.13"
PACKAGE_RELEASE="1"

DEPENDENCIES=()
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://www.alsa-project.org/files/pub/lib/alsa-lib-1.2.13.tar.bz2"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    # ALSA falls back to dirent64/stat64 aliases when the system has no LFS.
    # Include the real headers first so the aliases do not rewrite the struct
    # definitions when they are included later, and use alphasort because
    # dietlibc has no versionsort().
    local alsa_cflags="${CFLAGS:-}"
    if [ "${LIBC:-dietlibc}" = dietlibc ]; then
        sed -i '/^#ifndef HAVE_LFS$/i #include <sys/stat.h>\n#include <dirent.h>' include/local.h
        sed -i 's/^#define versionsort64 versionsort$/#define versionsort64 alphasort/' include/local.h
        alsa_cflags="$alsa_cflags -D__bitwise= -D__kernel_pid_t=int -D__kernel_off_t=long -D_SC_PAGE_SIZE=_SC_PAGESIZE"
    fi
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        --disable-shared \
        --enable-static \
        --disable-python \
        --disable-docs \
        CC="$CC" \
        CFLAGS="$alsa_cflags" \
        LDFLAGS="${LDFLAGS:-}"
    # The LFS probe succeeds spuriously against dietlibc's headers, but the
    # 64-bit aliases are not actually available on x86-64.  Use ALSA's own
    # fallback mapping instead.
    if [ "${LIBC:-dietlibc}" = dietlibc ]; then
        sed -i 's/^#define HAVE_LFS 1$/#undef HAVE_LFS/' include/config.h
    fi
    make -j"${JOBS:-$(nproc)}"
    make DESTDIR="$DESTDIR" install
}
