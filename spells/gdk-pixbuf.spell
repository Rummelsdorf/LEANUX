# gdk-pixbuf (dependency for gtk3)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="gdk-pixbuf"
PACKAGE_VERSION="2.42.12"
PACKAGE_RELEASE="1"

DEPENDENCIES=("glib" "libpng" "zlib")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://download.gnome.org/sources/gdk-pixbuf/2.42/gdk-pixbuf-2.42.12.tar.xz"
SOURCE_HASH="b9505b3445b9a7e48ced34760c3bcb73e966df3ac94c95a148cb669ab748e3c7"

BUILD_STYLE="meson"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC (meson)"
    # pixops.c uses lrint() without including <math.h>; the function itself is
    # provided by dietcompat, so only the -Werror diagnostic needs relaxing.
    # (Project flags add -Werror=implicit later; the more specific
    # -Wno-implicit-function-declaration still wins.)
    export CFLAGS="${CFLAGS:-} -Wno-implicit-function-declaration"
    # Upstream builds the loaders as static libraries and links them into
    # libgdk_pixbuf, but the dependency metadata only carries link_with.
    # Propagate the loader dependencies (libpng, ...) to executables so the
    # static link pulls in -lpng16.
    sed -i 's/included_loaders_deps += declare_dependency(link_with: mod)/included_loaders_deps += declare_dependency(link_with: mod, dependencies: loaders_deps + gdk_pixbuf_deps)/' \
        gdk-pixbuf/meson.build
    # The generated loaders.cache is only needed for the test suite.  The
    # statically linked query-loaders binary cannot run under dietlibc, so
    # generate a placeholder cache instead of executing it.
    python3 - <<'PY'
from pathlib import Path
p = Path('gdk-pixbuf/meson.build')
s = p.read_text()
old = """command: [
                                  gdk_pixbuf_query_loaders,
                                  dynamic_loaders,
                                ],"""
new = "command: [find_program('sh'), '-c', 'echo'],"
if old not in s:
    raise SystemExit('loaders.cache command block not found')
p.write_text(s.replace(old, new))
PY
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --default-library=static \
        -Dintrospection=disabled \
        -Ddocs=false \
        -Dman=false \
        -Dtests=false \
        -Dpng=enabled \
        -Djpeg=disabled \
        -Dtiff=disabled \
        -Dgif=disabled \
        || { cat build/meson-logs/meson-log.txt 2>/dev/null; return 1; }
    ninja -C build
    DESTDIR="$DESTDIR" meson install -C build
}
