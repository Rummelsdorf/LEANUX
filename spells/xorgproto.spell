# X.org protocol headers (dependency for all X11 libs/server)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="xorgproto"
PACKAGE_VERSION="2024.1"
PACKAGE_RELEASE="1"

DEPENDENCIES=()
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://www.x.org/releases/individual/proto/xorgproto-2024.1.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=0

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        CC="$CC" \
        CFLAGS="${CFLAGS:-}" \
        LDFLAGS="${LDFLAGS:-}"
    # Xfuncs.h exports bzero()/bcopy() as function-like macros.  That pollutes
    # later declarations in <strings.h> (and any project header including it)
    # because dietlibc declares the same functions.  Prefer the libc functions.
    sed -i \
        -e '/#  undef bzero/d' \
        -e '/#  define bzero(b,len) memset(b,0,len)/d' \
        -e '/#   define bzero(b,len) memset(b, 0, len)/d' \
        -e '/#   define bcmp(b1,b2,len) memcmp(b1, b2, len)/d' \
        include/X11/Xfuncs.h
    make -j"${JOBS:-$(nproc)}"
    make DESTDIR="$DESTDIR" install
}
