# atk (dependency for gtk3)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="atk"
PACKAGE_VERSION="2.54.0"
PACKAGE_RELEASE="1"

DEPENDENCIES=("glib")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://download.gnome.org/sources/atk/2.54/atk-2.54.0.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="meson"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC (meson)"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --default-library=static \
        -Dintrospection=disabled \
        -Ddocs=false \
        || { cat build/meson-logs/meson-log.txt 2>/dev/null; return 1; }
    ninja -C build
    DESTDIR="$DESTDIR" meson install -C build
}
