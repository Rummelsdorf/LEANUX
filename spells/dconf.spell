# dconf (dependency for MATE/GTK)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="dconf"
PACKAGE_VERSION="0.40.0"
PACKAGE_RELEASE="1"

DEPENDENCIES=("glib" "dbus")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://download.gnome.org/sources/dconf/0.40/dconf-0.40.0.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="meson"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC (meson)"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --default-library=static \
        -Dbash-completion=false \
        -Dman=false \
        -Dgtk-doc=false \
        -Dtests=false \
        || { cat build/meson-logs/meson-log.txt 2>/dev/null; return 1; }
    ninja -C build
    DESTDIR="$DESTDIR" meson install -C build
}
