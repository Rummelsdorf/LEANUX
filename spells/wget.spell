# GNU wget built with dietlibc for CLEANUX (fallback download tool)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="wget"
PACKAGE_VERSION="1.25.5"
PACKAGE_RELEASE="1"

DEPENDENCIES=("zlib" "openssl")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://ftp.gnu.org/gnu/wget/wget-1.25.5.tar.gz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        --disable-shared \
        --enable-static \
        --with-ssl=openssl \
        --without-libidn \
        --without-libpsl \
        --disable-iri \
        CC="$CC" \
        CFLAGS="${CFLAGS:-}" \
        LDFLAGS="${LDFLAGS:-}"
    make -j"${JOBS:-$(nproc)}"
    make DESTDIR="$DESTDIR" install
}
