# libxklavier – X keyboard configuration library (added port dependency of libmatekbd)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="libxklavier"
PACKAGE_VERSION="5.4"
PACKAGE_RELEASE="1"

DEPENDENCIES=("glib" "libX11" "libxkbfile" "xkeyboard-config")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://people.freedesktop.org/~svu/libxklavier-5.4.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        --disable-shared \
        --enable-static \
        CC="$CC" \
        CFLAGS="${CFLAGS:-}" \
        LDFLAGS="${LDFLAGS:-}"
    make -j"${JOBS:-$(nproc)}"
    make DESTDIR="$DESTDIR" install
}
