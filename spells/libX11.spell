# libX11 built with dietlibc (dependency for xorg-server, mate, vlc)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="libX11"
PACKAGE_VERSION="1.8.10"
PACKAGE_RELEASE="1"

DEPENDENCIES=("xorgproto" "libxcb" "libXau" "libXdmcp")
EXTERNAL_DEPENDENCIES=("xtrans")
SOURCE_URL="https://www.x.org/releases/individual/lib/libX11-1.8.10.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        --disable-shared \
        --enable-static \
        --disable-specs \
        --disable-devel-docs \
        CC="$CC" \
        CFLAGS="${CFLAGS:-}" \
        LDFLAGS="${LDFLAGS:-}"
    make -j"${JOBS:-$(nproc)}"
    make DESTDIR="$DESTDIR" install
}
