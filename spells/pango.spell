# pango (dependency for gtk3)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="pango"
PACKAGE_VERSION="1.54.0"
PACKAGE_RELEASE="1"

DEPENDENCIES=("glib" "cairo" "harfbuzz" "freetype" "fontconfig")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://download.gnome.org/sources/pango/1.54/pango-1.54.0.tar.xz"
SOURCE_HASH="8a9eed75021ee734d7fc0fdf3a65c3bba51dfefe4ae51a9b414a60c70b2d1ed8"

BUILD_STYLE="meson"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC (meson)"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --default-library=static \
        -Dintrospection=disabled \
        -Ddocumentation=false \
        -Dbuild-testsuite=false \
        -Dcairo=enabled \
        -Dfontconfig=enabled \
        -Dfreetype=enabled \
        || { cat build/meson-logs/meson-log.txt 2>/dev/null; return 1; }
    ninja -C build
    DESTDIR="$DESTDIR" meson install -C build
}
