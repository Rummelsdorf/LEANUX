# Midnight Commander built with dietlibc
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="mc"
PACKAGE_VERSION="4.8.32"
PACKAGE_RELEASE="1"

DEPENDENCIES=("ncurses" "glib")
EXTERNAL_DEPENDENCIES=("libssh2")
SOURCE_URL="https://ftp.midnight-commander.org/mc-4.8.32.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        --disable-shared \
        --enable-static \
        --without-x \
        --disable-doxygen \
        --disable-nls \
        CC="$CC" \
        CFLAGS="${CFLAGS:-}" \
        LDFLAGS="${LDFLAGS:-}"
    make -j"${JOBS:-$(nproc)}"
    make DESTDIR="$DESTDIR" install
}
