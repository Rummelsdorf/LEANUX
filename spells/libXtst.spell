# libXtst (dependency for X server/MATE)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="libXtst"
PACKAGE_VERSION="1.2.4"
PACKAGE_RELEASE="1"

DEPENDENCIES=("xorgproto" "libX11" "libXext" "libXi")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://www.x.org/releases/individual/lib/libXtst-1.2.4.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        --disable-shared \
        --enable-static \
        CC="$CC" \
        CFLAGS="${CFLAGS:-}" \
        LDFLAGS="${LDFLAGS:-}"
    make -j"${JOBS:-$(nproc)}"
    make DESTDIR="$DESTDIR" install
}
