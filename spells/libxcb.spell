# libxcb (dependency for libX11 and X server)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="libxcb"
PACKAGE_VERSION="1.17.0"
PACKAGE_RELEASE="1"

DEPENDENCIES=("xorgproto" "xcb-proto" "libXau" "libXdmcp" "libpthread-stubs")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://www.x.org/releases/individual/lib/libxcb-1.17.0.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        --disable-shared \
        --enable-static \
        --disable-devel-docs \
        --without-doxygen \
        CC="$CC" \
        CFLAGS="${CFLAGS:-}" \
        LDFLAGS="${LDFLAGS:-}"
    make -j"${JOBS:-$(nproc)}"
    make DESTDIR="$DESTDIR" install
}
