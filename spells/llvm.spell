# LLVM/Clang (prerequisite for building Firefox/Rust from source)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="llvm"
PACKAGE_VERSION="19.1.3"
PACKAGE_RELEASE="1"

DEPENDENCIES=("zlib")
EXTERNAL_DEPENDENCIES=("cmake" "ninja")
SOURCE_URL="https://github.com/llvm/llvm-project/releases/download/llvmorg-19.1.3/llvm-project-19.1.3.src.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="custom"
LANGUAGE="c++"
FALLBACK_ALLOWED=1
USE_DIETCOMPAT=1

build() {
    log "Configuring LLVM/Clang with $CC"
    cmake -S llvm -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER="$CC" \
        -DCMAKE_CXX_COMPILER="${CXX:-g++}" \
        -DLLVM_ENABLE_PROJECTS="clang;lld" \
        -DLLVM_TARGETS_TO_BUILD=X86 \
        -DLLVM_ENABLE_TERMINFO=OFF \
        -DLLVM_ENABLE_ZLIB=ON \
        -DLLVM_INCLUDE_TESTS=OFF \
        -DLLVM_INCLUDE_EXAMPLES=OFF
    cmake --build build -j"${JOBS:-$(nproc)}"
    DESTDIR="$DESTDIR" cmake --install build
}
