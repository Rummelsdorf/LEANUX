# harfbuzz (dependency for freetype/pango)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="harfbuzz"
PACKAGE_VERSION="10.1.0"
PACKAGE_RELEASE="1"

DEPENDENCIES=()
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://github.com/harfbuzz/harfbuzz/releases/download/10.1.0/harfbuzz-10.1.0.tar.xz"
SOURCE_HASH="6ce3520f2d089a33cef0fc48321334b8e0b72141f6a763719aaaecd2779ecb82"

BUILD_STYLE="meson"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC (meson)"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --default-library=static \
        -Dgobject=disabled \
        -Dglib=disabled \
        -Dicu=disabled \
        -Dgraphite2=disabled \
        -Dfreetype=disabled \
        -Dtests=disabled \
        -Ddocs=disabled \
        -Dintrospection=disabled \
        || { cat build/meson-logs/meson-log.txt 2>/dev/null; return 1; }
    ninja -C build
    DESTDIR="$DESTDIR" meson install -C build
}
