# xkeyboard-config (dependency for xorg-server)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="xkeyboard-config"
PACKAGE_VERSION="2.43"
PACKAGE_RELEASE="1"

DEPENDENCIES=("xorgproto")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://www.x.org/releases/individual/data/xkeyboard-config-2.43.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=0

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        CC="$CC" \
        CFLAGS="${CFLAGS:-}" \
        LDFLAGS="${LDFLAGS:-}"
    make -j"${JOBS:-$(nproc)}"
    make DESTDIR="$DESTDIR" install
}
