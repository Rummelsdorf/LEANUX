# NASM (prerequisite for Firefox/media codecs)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="nasm"
PACKAGE_VERSION="2.16.03"
PACKAGE_RELEASE="1"

DEPENDENCIES=()
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://www.nasm.us/pub/nasm/releasebuilds/2.16.03/nasm-2.16.03.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        CC="$CC" \
        CFLAGS="${CFLAGS:-}" \
        LDFLAGS="${LDFLAGS:-}"
    make -j"${JOBS:-$(nproc)}"
    make DESTDIR="$DESTDIR" install
}
