# NASM (prerequisite for Firefox/media codecs)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="nasm"
PACKAGE_VERSION="2.16.03"
PACKAGE_RELEASE="1"

DEPENDENCIES=()
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://www.nasm.us/pub/nasm/releasebuilds/2.16.03/nasm-2.16.03.tar.xz"
SOURCE_HASH="PLACEHOLDER_HASH"

BUILD_STYLE="configure"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring ${PACKAGE_NAME} with $CC"
    ./configure \
        --prefix=/usr \
        --build="$(gcc -dumpmachine)" \
        CC="$CC" \
        CFLAGS="${CFLAGS:-} -DHAVE_MEMPCPY=1" \
        LDFLAGS="${LDFLAGS:-}"
    # libnasm.a is linked after the LDFLAGS that carry -ldietcompat, so add
    # the shim again at the end of the link line (dietlibc builds only).
    local libs="-lm"
    [ "${LIBC:-dietlibc}" = dietlibc ] && libs="-ldietcompat $libs"
    make -j"${JOBS:-$(nproc)}" LIBS="$libs"
    make DESTDIR="$DESTDIR" install
}
