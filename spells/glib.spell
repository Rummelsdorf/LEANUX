# glib (dependency for gtk3, dbus, gsettings; meson build)
# Ported from CLEANUX (2026-11-08).
PACKAGE_NAME="glib"
PACKAGE_VERSION="2.60.7"
PACKAGE_RELEASE="1"

DEPENDENCIES=("zlib" "libffi" "pcre2")
EXTERNAL_DEPENDENCIES=()
SOURCE_URL="https://download.gnome.org/sources/glib/2.60/glib-2.60.7.tar.xz"
SOURCE_HASH="8b12c0af569afd3b71200556ad751bad4cf4bf7bc4b5f880638459a42ca86310"

BUILD_STYLE="custom"
LANGUAGE="c"
FALLBACK_ALLOWED=0
USE_DIETCOMPAT=1

build() {
    log "Configuring GLib with $CC (meson)"

    # GLib uses a few interfaces dietlibc does not implement.  These patches
    # are carried over from CLEANUX's glib spell and must not be applied to
    # the glibc reference build.
    if [ "${LIBC:-dietlibc}" = dietlibc ]; then
    python3 - "$PWD" <<'PY'
import re, sys
root = sys.argv[1]
p = root + "/glib/ggettext.c"
s = open(p).read()
s = s.replace("#include <libintl.h>\n", "#include <libintl.h>\n#ifdef dngettext\n#undef dngettext\n#endif\n", 1)
open(p, "w").write(s)
p = root + "/glib/glib-init.c"
s = open(p).read()
if "#include <strings.h>" not in s:
    s = s.replace("#include <string.h>\n", "#include <string.h>\n#include <strings.h>\n", 1)
open(p, "w").write(s)
p = root + "/glib/gstrfuncs.c"
s = open(p).read()
if "#include <strings.h>" not in s:
    s = s.replace("#include <string.h>\n", "#include <string.h>\n#include <strings.h>\n", 1)
open(p, "w").write(s)
p = root + "/glib/gunicollate.c"
s = open(p).read()
s = re.sub(r"xfrm_len = strxfrm \(NULL, str_norm, 0\);",
           "{ char _dummy[1]; xfrm_len = strxfrm (_dummy, str_norm, 0); }", s)
s = re.sub(r"xfrm_len = strxfrm \(NULL, str_locale, 0\);",
           "{ char _dummy[1]; xfrm_len = strxfrm (_dummy, str_locale, 0); }", s)
open(p, "w").write(s)
p = root + "/gio/gunixconnection.c"
s = open(p).read()
s = s.replace('#include "glibintl.h"\n', '#include "glibintl.h"\n#ifdef dngettext\n#undef dngettext\n#endif\n', 1)
open(p, "w").write(s)
p = root + "/glib/gthread-posix.c"
s = open(p).read()
s = s.replace("  pthread_mutexattr_init (&attr);\n  pthread_mutexattr_settype (&attr, PTHREAD_MUTEX_RECURSIVE);\n  pthread_mutex_init (mutex, &attr);",
              "  pthread_mutexattr_init (&attr);\n  /* dietlibc lacks pthread_mutexattr_settype; skip */\n  pthread_mutex_init (mutex, &attr);")
s = s.replace("#else\n#error Cannot support GCond on your platform.\n#endif",
              "#else\n/* dietlibc: no monotonic clock; use default */\n#endif")
open(p, "w").write(s)
p = root + "/glib/gspawn.c"
s = open(p).read()
s = s.replace("while ((nread = syscall (SYS_getdents64, dir_fd, buf, sizeof(buf))) > 0)",
              "while ((nread = getdents64 (dir_fd, (struct dirent64 *) buf, sizeof(buf))) > 0)")
# dietlibc has no spawn.h; the host header conflicts with dietlibc's signal
# types. HAVE_POSIX_SPAWN is not detected, so removing the include is safe.
s = s.replace("#ifdef HAVE_SPAWN_H\n#include <spawn.h>\n#endif /* HAVE_SPAWN_H */",
              "/* dietlibc: no spawn.h; posix_spawn is unavailable */")
open(p, "w").write(s)
p = root + "/gio/gthreadedresolver.c"
s = open(p).read()
if '#include <sys/types.h>\n\n#ifndef GETSHORT' not in s:
    s = s.replace('#include "gnetworkingprivate.h"\n',
                  '#include "gnetworkingprivate.h"\n#include <sys/types.h>\n\n#ifndef GETSHORT\n#define GETSHORT(s, cp) do { const u_char *t_cp = (const u_char *)(cp); (s) = ((uint16_t)t_cp[0] << 8) | ((uint16_t)t_cp[1]); (cp) += 2; } while(0)\n#endif\n#ifndef GETLONG\n#define GETLONG(l, cp) do { const u_char *t_cp = (const u_char *)(cp); (l) = ((uint32_t)t_cp[0] << 24) | ((uint32_t)t_cp[1] << 16) | ((uint32_t)t_cp[2] << 8) | ((uint32_t)t_cp[3]); (cp) += 4; } while(0)\n#endif\n', 1)
open(p, "w").write(s)
p = root + "/gio/gsettingsschema.c"
s = open(p).read()
s = s.replace("  if (schema->gettext_domain)\n    bind_textdomain_codeset (schema->gettext_domain, \"UTF-8\");",
              "  if (schema->gettext_domain)\n    { /* dietlibc lacks bind_textdomain_codeset; no-op */ }")
open(p, "w").write(s)
print("patched")
PY
    fi

    if [ "${LIBC:-dietlibc}" = dietlibc ]; then
        # Keep host compiler fallback headers after the dietlibc include paths
        # so that asm/ and linux/ headers resolve without replacing dietlibc.
        local gcc_inc multiarch extra_includes=""
        gcc_inc=$(gcc -print-file-name=include 2>/dev/null || true)
        multiarch=$(gcc -dumpmachine 2>/dev/null || true)
        [ -n "$gcc_inc" ] && extra_includes="$extra_includes -idirafter $gcc_inc"
        [ -n "$multiarch" ] && extra_includes="$extra_includes -idirafter /usr/include/$multiarch"

        export CFLAGS="$CFLAGS -D_BSD_SOURCE -DPTHREAD_MUTEX_RECURSIVE=PTHREAD_MUTEX_RECURSIVE_NP -DSYS_getdents64=217 -DIPV6_JOIN_GROUP=IPV6_ADD_MEMBERSHIP -DIPV6_LEAVE_GROUP=IPV6_DROP_MEMBERSHIP -D__attribute_deprecated__=__attribute__((deprecated)) -Wno-format-nonliteral $extra_includes"
        export LDFLAGS="$LDFLAGS -lpthread -ldietcompat -lm"
    else
        export LDFLAGS="$LDFLAGS -lpthread -lm"
    fi

    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --default-library=static \
        -Dlibmount=false \
        -Dinternal_pcre=true \
        -Dselinux=disabled \
        -Dman=false \
        -Dgtk_doc=false \
        || { cat build/meson-logs/meson-log.txt 2>/dev/null; return 1; }

    # Host tools from GLib are unstable under dietlibc; build the libraries
    # only (same approach as CLEANUX).
    ninja -C build glib/libglib-2.0.a gobject/libgobject-2.0.a gio/libgio-2.0.a gmodule/libgmodule-2.0.a

    install -d "$DESTDIR/usr/lib" "$DESTDIR/usr/include/glib-2.0" \
        "$DESTDIR/usr/include/glib-2.0/glib/deprecated" \
        "$DESTDIR/usr/include/glib-2.0/gobject" \
        "$DESTDIR/usr/include/glib-2.0/gio" \
        "$DESTDIR/usr/include/glib-2.0/gmodule" \
        "$DESTDIR/usr/include/gio-unix-2.0/gio" \
        "$DESTDIR/usr/lib/glib-2.0/include" \
        "$DESTDIR/usr/lib/pkgconfig"
    install -m644 build/glib/libglib-2.0.a "$DESTDIR/usr/lib/"
    install -m644 build/gobject/libgobject-2.0.a "$DESTDIR/usr/lib/"
    install -m644 build/gio/libgio-2.0.a "$DESTDIR/usr/lib/"
    install -m644 build/gmodule/libgmodule-2.0.a "$DESTDIR/usr/lib/"
    cp glib/*.h "$DESTDIR/usr/include/glib-2.0/glib/"
    cp glib/glib.h "$DESTDIR/usr/include/glib-2.0/" 2>/dev/null || true
    cp glib/glib-unix.h "$DESTDIR/usr/include/glib-2.0/" 2>/dev/null || true
    cp glib/glib-object.h "$DESTDIR/usr/include/glib-2.0/" 2>/dev/null || true
    cp glib/deprecated/*.h "$DESTDIR/usr/include/glib-2.0/glib/deprecated/" 2>/dev/null || true
    cp gobject/*.h "$DESTDIR/usr/include/glib-2.0/gobject/"
    cp gobject/glib-object.h "$DESTDIR/usr/include/glib-2.0/" 2>/dev/null || true
    cp build/gobject/glib-enumtypes.h "$DESTDIR/usr/include/glib-2.0/gobject/" 2>/dev/null || true
    cp gio/*.h "$DESTDIR/usr/include/glib-2.0/gio/"
    cp build/gio/gioenumtypes.h "$DESTDIR/usr/include/glib-2.0/gio/" 2>/dev/null || true
    cp gmodule/*.h "$DESTDIR/usr/include/glib-2.0/gmodule/"
    cp gmodule/gmodule.h "$DESTDIR/usr/include/glib-2.0/" 2>/dev/null || true
    cp gio/gunix*.h "$DESTDIR/usr/include/gio-unix-2.0/gio/"
    cp build/glib/glibconfig.h "$DESTDIR/usr/lib/glib-2.0/include/"

    # Build-time helper scripts.  These are Python scripts, so they run
    # independently of the dietlibc-built libraries.  The compiled helpers
    # (glib-compile-schemas, glib-compile-resources) pull in the gnulib
    # printf objects and are therefore taken from the host when available.
    install -d "$DESTDIR/usr/bin" "$DESTDIR/usr/share/glib-2.0/codegen"
    install -m755 build/gobject/glib-genmarshal "$DESTDIR/usr/bin/"
    install -m755 build/gobject/glib-mkenums "$DESTDIR/usr/bin/"
    install -m755 build/gio/gdbus-2.0/codegen/gdbus-codegen "$DESTDIR/usr/bin/"
    cp build/gio/gdbus-2.0/codegen/*.py "$DESTDIR/usr/share/glib-2.0/codegen/"

    cat > "$DESTDIR/usr/lib/pkgconfig/glib-2.0.pc" <<EOF
prefix=/usr
includedir=\${prefix}/include
libdir=\${prefix}/lib

Name: GLib
Description: C Utility Library
Version: $PACKAGE_VERSION
glib_genmarshal=glib-genmarshal
gobject_query=gobject-query
glib_mkenums=glib-mkenums
glib_compile_resources=glib-compile-resources
Libs: -L\${libdir} -lglib-2.0 -lpthread
Cflags: -I\${includedir}/glib-2.0 -I\${libdir}/glib-2.0/include
EOF
    cat > "$DESTDIR/usr/lib/pkgconfig/gobject-2.0.pc" <<EOF
prefix=/usr
includedir=\${prefix}/include
libdir=\${prefix}/lib

Name: GObject
Description: GLib Type, Object, Parameter and Signal Library
Version: $PACKAGE_VERSION
Requires: glib-2.0
Libs: -L\${libdir} -lgobject-2.0
Cflags: -I\${includedir}/glib-2.0 -I\${libdir}/glib-2.0/include
EOF
    cat > "$DESTDIR/usr/lib/pkgconfig/gio-2.0.pc" <<EOF
prefix=/usr
includedir=\${prefix}/include
libdir=\${prefix}/lib

Name: GIO
Description: glib I/O library
Version: $PACKAGE_VERSION
Requires: glib-2.0 gobject-2.0
Libs: -L\${libdir} -lgio-2.0
Cflags: -I\${includedir}/glib-2.0 -I\${libdir}/glib-2.0/include
EOF
    cat > "$DESTDIR/usr/lib/pkgconfig/gmodule-2.0.pc" <<EOF
prefix=/usr
includedir=\${prefix}/include
libdir=\${prefix}/lib

Name: GModule
Description: Dynamic module loader for GLib
Version: $PACKAGE_VERSION
Requires: glib-2.0
gmodule_supported=true
Libs: -L\${libdir} -lgmodule-2.0 -ldl -lpthread
Cflags: -I\${includedir}/glib-2.0 -I\${libdir}/glib-2.0/include
EOF
    cat > "$DESTDIR/usr/lib/pkgconfig/gmodule-no-export-2.0.pc" <<EOF
prefix=/usr
includedir=\${prefix}/include
libdir=\${prefix}/lib

Name: GModule
Description: Dynamic module loader for GLib
Version: $PACKAGE_VERSION
Requires: glib-2.0
gmodule_supported=true
gmodule_export=false
Libs: -L\${libdir} -lgmodule-2.0 -ldl -lpthread
Cflags: -I\${includedir}/glib-2.0 -I\${libdir}/glib-2.0/include
EOF

    # Prefer the pkg-config files generated by Meson.  Unlike the minimal
    # hand-written copies above they carry the complete dependency metadata
    # (libffi, gmodule-no-export, schemasdir, glib_compile_schemas, ...) that
    # static downstream builds such as ATK, dconf and gsettings need.
    for pc in glib-2.0 gobject-2.0 gio-2.0 gio-unix-2.0 gmodule-2.0 \
              gmodule-no-export-2.0 gthread-2.0; do
        if [ -f "build/meson-private/$pc.pc" ]; then
            cp "build/meson-private/$pc.pc" "$DESTDIR/usr/lib/pkgconfig/$pc.pc"
        fi
    done

    # gnome.post_install() needs an executable glib-compile-schemas.  The
    # dietlibc build cannot link it because of GLib's gnulib printf objects,
    # so point the metadata at the host tool used during the build.
    if host_schemas=$(command -v glib-compile-schemas 2>/dev/null); then
        sed -i "s|^glib_compile_schemas=.*|glib_compile_schemas=$host_schemas|" \
            "$DESTDIR/usr/lib/pkgconfig/gio-2.0.pc"
    fi
}
